# Football Leagues Platform — root Apache config

# Use index.php as directory index
DirectoryIndex index.php index.html

# Security headers (mirrors PHP-emitted headers for static requests)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block access to sensitive files
<FilesMatch "(^\.|composer\.(json|lock)|\.sql|\.md|config\.php|config\.sample\.php)$">
    Require all denied
</FilesMatch>

# Protect the application code directory
RedirectMatch 403 ^/app/.*$

# Disable directory listing
Options -Indexes

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Static asset caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
