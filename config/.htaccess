# Bloquea el acceso web a la raiz del proyecto.
# Solo public/ debe quedar expuesto. Si su hosting no permite apuntar el
# dominio a public/, este archivo evita que se descarguen config/, src/ y storage/.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
