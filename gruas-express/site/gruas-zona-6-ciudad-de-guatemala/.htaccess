# Carpeta pública de solo lectura: sin scripts, sin listado de directorios.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .pht .phar .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh
  RemoveType .php .phtml .pht .phar .php3 .php4 .php5 .php7 .php8 .phps
</IfModule>
<FilesMatch "(?i)\.(php[0-9]*|phtml|pht|phps|phar|pgif|shtml|cgi|pl|py|sh|bash|asp|aspx|jsp|exe|dll|so|htaccess|htpasswd|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
# Solo se sirven los tipos de archivo esperados en esta carpeta
<FilesMatch "^(?=.*\.)(?!.+\.(html)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
