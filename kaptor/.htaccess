# ============================================================================
#  Kaptor · Configuración de Apache
#  Válido para hosting compartido con Apache 2.2 / 2.4 (cPanel, Plesk, DirectAdmin).
#  Si tu servidor usa Nginx, pide a tu proveedor el equivalente de estas reglas.
# ============================================================================

# ------------------------------------------------- Página de inicio
DirectoryIndex index.php index.html

# ------------------------------------------------- Sin listados de carpetas
Options -Indexes

# ------------------------------------------------- Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always unset X-Powered-By
  Header unset Server
</IfModule>

# ------------------------------------------------- Archivos que nadie debe leer
<FilesMatch "^(composer\.(json|lock)|\.env|\.gitignore|README\.md|schema\.sql|.*\.log|.*\.lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------- Carpetas internas
RedirectMatch 403 ^/(config|includes|storage|database)(/.*)?$

# ------------------------------------------------- Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------- Caché de los recursos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ------------------------------------------------- Tipos MIME correctos
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# ------------------------------------------------- UTF-8 por defecto
AddDefaultCharset UTF-8

# ------------------------------------------------- Límites recomendados
<IfModule mod_php.c>
  php_value max_execution_time 120
  php_value memory_limit 256M
  php_value default_charset "UTF-8"
</IfModule>
