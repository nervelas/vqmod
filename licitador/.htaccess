# Licitador - URLs limpias y protección
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bloquear carpetas internas y archivos sensibles
  RewriteRule ^(config|storage|cron-internal|src|database)(/|$) - [F,L]
  RewriteRule \.(sql|log|env|ini|bak|lock|md)$ - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  # Todo lo que no sea archivo/carpeta real va al controlador frontal
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Sin mod_rewrite: las URLs funcionan como index.php?r=ruta (activa "URLs limpias = No" en Admin -> Ajustes)
<IfModule !mod_rewrite.c>
  <FilesMatch "\.(sql|log|env|ini|bak|lock)$">
    Require all denied
  </FilesMatch>
</IfModule>

<FilesMatch "\.(sql|log|env|bak|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header setIfEmpty X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|woff2|webp|svg|png|jpg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
