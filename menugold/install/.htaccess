# El instalador solo debe verse mientras no exista install/.lock.
# El propio index.php se bloquea; esta regla protege los archivos auxiliares.
<FilesMatch "^(demo\.php|\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
