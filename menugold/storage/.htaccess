# ===========================================================
#  /storage : contenido interno. Nunca se sirve directamente
#  ni se ejecuta nada aqui; los archivos salen por index.php.
# ===========================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
