# Las imágenes se sirven, pero nunca se ejecuta código en esta carpeta.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI -Indexes
AddHandler cgi-script .php .phtml .php3 .pl .py .cgi
RemoveHandler .php .phtml .php3
