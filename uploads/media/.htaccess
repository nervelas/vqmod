# Serve files but never execute code inside uploads
php_flag engine off
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|sh|asp|aspx|jsp)$">
    Require all denied
    Deny from all
</FilesMatch>
Options -ExecCGI -Indexes
AddType text/plain .php .phtml
